MONGODB_URI=mongodb://127.0.0.1:27017/story_app
AUTH_SECRET=
# Tools server (task 54, D56): `npm run up` fills both locally.
TOOLS_API_URL=
TOOLS_API_SECRET=
# Covers (task 26, D68): estimates until measured in Atlas (task 67).
COVERS_MAX_TOTAL_MB=150
COVERS_ADULT_THRESHOLD=0.5
# Rate limits per address (task 57, D74): on Vercel the address comes from x-vercel-forwarded-for.
# Elsewhere name a header the proxy sets and the client cannot; empty turns those limits off.
TRUSTED_IP_HEADER=
