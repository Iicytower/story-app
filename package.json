{
  "name": "story_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "db:up": "docker compose up -d --wait mongo",
    "up": "tsx scripts/tools.ts up; npm run dev",
    "down": "tsx scripts/tools.ts down",
    "tools:remote": "tsx scripts/tools.ts remote",
    "dict:build": "tsx scripts/dictionary.ts build",
    "dict:upload": "tsx scripts/dictionary.ts upload",
    "dict:upload:remote": "tsx scripts/dictionary.ts upload-remote",
    "create-account": "tsx --env-file=.env.local scripts/create-account.ts",
    "migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "tags": "tsx --env-file=.env.local scripts/predefined-tags.ts",
    "admin": "tsx --env-file=.env.local scripts/admin.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "backup": "bash scripts/backup.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/markdown": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "diff": "^9.0.0",
    "docx": "^9.15.3",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.3",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.70.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.3",
    "mongoose": "^9.12.1",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "pdfkit": "^0.20.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.21.0",
    "recharts": "^3.10.1",
    "remark-breaks": "^4.0.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "turndown": "^7.2.5",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.6"
    }
  }
}
