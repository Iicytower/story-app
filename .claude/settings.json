{
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run test*)",
      "Bash(npm test*)",
      "Bash(npm run build*)",
      "Bash(npm run dev*)",
      "Bash(npm run format*)",
      "Bash(npm run start*)",
      "Bash(npm ls*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(npx prettier*)",
      "Bash(npx vitest*)",
      "Bash(npx shadcn@latest add*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git checkout*)",
      "Bash(npm run test:e2e*)",
      "Bash(npm run verify*)",
      "Bash(npx playwright test*)",
      "Bash(npx playwright show-report*)",
      "Agent(researcher)",
      "Agent(implementer)",
      "Agent(verifier)",
      "Agent(reviewer)",
      "Agent(ui-checker)",
      "Agent(security-auditor)",
      "Agent(docs-keeper)",
      "Agent(merger)",
      "Bash(git merge*)",
      "Bash(git switch*)",
      "Bash(git branch*)",
      "Bash(git mv*)",
      "Bash(git rm*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(docker compose*)",
      "Bash(docker ps*)",
      "Bash(docker logs*)",
      "Bash(docker exec*)",
      "Bash(npm run up*)",
      "Bash(npm run down*)",
      "Bash(npm run db:up*)",
      "Bash(npm run migrate*)",
      "Bash(npx tsx*)",
      "Bash(node *)",
      "Bash(curl -s http://localhost*)",
      "Bash(curl -s http://127.0.0.1*)",
      "Bash(ssh -p 10022 *)",
      "Bash(npm view*)",
      "Bash(npm outdated*)",
      "WebFetch",
      "WebSearch",
      "Bash(npm run seed*)",
      "mcp__playwright",
      "mcp__shadcn"
    ],
    "deny": [
      "Bash(npm run tools:remote*)",
      "Bash(npm run dict:upload:remote*)",
      "Read(./.next/**)",
      "Read(./.next-*/**)",
      "Read(./playwright-report/**)",
      "Read(./test-results/**)",
      "Read(./package-lock.json)",
      "Read(./coverage/**)",
      "mcp__claude-in-chrome"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm uninstall*)",
      "Bash(git push*)",
      "Bash(npm run create-account*)",
      "Bash(npx playwright install*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-branches.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/autorun-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/autorun-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/autorun-continue.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "implementer|verifier|merger",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/autorun-state.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
